{
  "listen": ":27018",
  "upstream": {
    "uri": "mongodb://proxy-user:CHANGE_ME@mongo-1.internal:27017,mongo-2.internal:27017,mongo-3.internal:27017/?replicaSet=rs0&authSource=admin&tls=true",
    "caFile": "/etc/ssl/mongo-ca.pem",
    "pool": { "mode": "pooled", "maxSize": 100, "idleTimeout": "5m" }
  },
  "tenant": { "field": "tenantId", "idType": "string" },
  "databases": ["app"],
  "auth": {
    "mode": "scram",
    "users": [
      {
        "username": "acme",
        "tenantId": "acme",
        "salt": "<from hash-password>",
        "iterations": 15000,
        "storedKey": "<from hash-password>",
        "serverKey": "<from hash-password>"
      }
    ]
  },
  "maxConnsPerTenant": 200,
  "idleTimeout": "10m",
  "metricsAddr": "127.0.0.1:9102",
  "logLevel": "info"
}
